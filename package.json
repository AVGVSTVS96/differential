{
  "name": "differential",
  "version": "0.1.0",
  "description": "Terminal diff viewer with syntax highlighting powered by OpenTUI",
  "type": "module",
  "bin": {
    "differential": "./src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "diff",
    "terminal",
    "tui",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentui/core": "^0.1.54",
    "@opentui/react": "^0.1.54",
    "cac": "^6.7.14",
    "diff": "^8.0.2",
    "react": "^19.0.0",
    "shiki": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^7.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.3.0"
  }
}
